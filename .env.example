# ── Telegram Bot ──────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
OWNER_ID=your_telegram_user_id

# ── Facebook Page ─────────────────────────────────────────────────
# 到 https://developers.facebook.com → Graph API Explorer 取得
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_TOKEN=your_page_access_token   # 需要 pages_manage_posts 權限

# ── Instagram Business ────────────────────────────────────────────
# 必須是 Business 或 Creator 帳號，且已連結到上方的 FB Page
IG_USER_ID=your_instagram_business_user_id

# ── imgbb（免費圖床，供 IG 圖片上傳使用）──────────────────────────
# 申請：https://api.imgbb.com（免費，每月無限上傳）
IMGBB_API_KEY=your_imgbb_api_key
